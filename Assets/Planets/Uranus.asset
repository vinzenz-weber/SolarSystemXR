  planetName: Uranus
  subHeadline: The icy, tilted blue giant
  shortDescription: Uranus is a cold ice giant tilted by almost 98 degrees, making
    it appear to lie on its side. Its pale blue color comes from methane gas in its
    atmosphere.
  planetImage: {fileID: 0}
  menuButtonImage: {fileID: 21300000, guid: 2e4537ea7b2e185458df855e1badf4e1, type: 3}
