  m_Name: Mond
  m_EditorClassIdentifier: Assembly-CSharp::PlanetData
  planetName: Mond
  subHeadline: Der einzige natuerliche Begleiter der Erde
  shortDescription: "Der Mond ist der einzige natuerliche Satellit der Erde. Seine
    kraterreiche Oberflaeche, seine Phasen und seine gebundene Rotation machen ihn
    zu einem besonders anschaulichen Lernobjekt."
