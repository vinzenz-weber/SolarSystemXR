  m_Name: Venus
  m_EditorClassIdentifier: Assembly-CSharp::PlanetData
  planetName: Venus
  subHeadline: Hellishly hot sister planet of Earth
  shortDescription: Although Venus is similar in size to Earth, its dense, toxic
    cloud cover hides an extremely hot surface under enormous pressure.
