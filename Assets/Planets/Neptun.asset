  m_Name: Neptun
  m_EditorClassIdentifier: Assembly-CSharp::PlanetData
  planetName: Neptune
  subHeadline: "St\xFCrmischer Eisriese am \xE4u\xDFeren Rand"
  shortDescription: "Der \xE4u\xDFerste regul\xE4re Planet ist eine dunkle, eiskalte
    Welt, die von \xDCberschallwinden und massiven St\xFCrmen in ihrer tiefblauen
    Atmosph\xE4re gepeitscht wird."
  planetImage: {fileID: 0}
  menuButtonImage: {fileID: 21300000, guid: 0e0ed8dc62b11b245af3e8d44806eac2, type: 3}
