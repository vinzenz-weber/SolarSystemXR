    {\n        \"m_Expanded\": true,\n        \"m_Position\": {\n            \"serializedVersion\":
    \"2\",\n            \"x\": -4302.66650390625,\n            \"y\": -2191.3330078125,\n           
    \"width\": 208.000244140625,\n            \"height\": 126.666748046875\n       
    }\n    },\n    \"m_Slots\": [\n        {\n            \"m_Id\": \"3750e728961c465c93a11fccd95bb6c9\"\n       
    },\n        {\n            \"m_Id\": \"0331f4fb1dc84cdfac4e9652ee692204\"\n       
