    {\n        \"m_Expanded\": true,\n        \"m_Position\": {\n            \"serializedVersion\":
    \"2\",\n            \"x\": -3929.333740234375,\n            \"y\": -2376.000244140625,\n           
    \"width\": 143.333251953125,\n            \"height\": 46.666748046875\n       
    }\n    },\n    \"m_Slots\": [\n        {\n            \"m_Id\": \"200f3800f0aa4ebf9034e1ce841e8a3b\"\n       
    },\n        {\n            \"m_Id\": \"59c418ad2fbe43048fdf38961836e4f8\"\n       
    },\n        {\n            \"m_Id\": \"ac80f259f2474344a3d4a7cce4429276\"\n       
    }\n    ],\n    \"synonyms\": [\n        \"code\",\n        \"HLSL\"\n    ],\n   
    \"m_Precision\": 0,\n    \"m_PreviewExpanded\": false,\n    \"m_DismissedVersion\":
    0,\n    \"m_PreviewMode\": 0,\n    \"m_CustomColors\": {\n        \"m_SerializableColors\":
    []\n    },\n    \"m_SourceType\": 1,\n    \"m_FunctionName\": \"PUV\",\n    \"m_FunctionSource\":
    \"\",\n    \"m_FunctionSourceUsePragmas\": true,\n    \"m_FunctionBody\": \"void
    PlanetUV_float(float3 dir, out float2 uv)\\r\\n{\\r\\n    float2 rawUV;\\r\\n   
    rawUV.x = atan2(dir.x, dir.y) / 6.2832 + 0.5;\\r\\n    rawUV.y = asin(dir.z)
    / 3.1416 + 0.5;\\r\\n    \\r\\n    // Fix seam by computing correct mip/derivatives\\r\\n   
    float2 dx = ddx(rawUV);\\r\\n    float2 dy = ddy(rawUV);\\r\\n    \\r\\n    //
    Clamp derivatives at the wrapping seam\\r\\n    if(abs(dx.x) > 0.5) dx.x = 0;\\r\\n   
    if(abs(dy.x) > 0.5) dy.x = 0;\\r\\n    \\r\\n    uv = rawUV;\\r\\n}\"\n}\n\n{\n   
